{
  "version": 8,
  "name": "Wanderpage paper",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "© OpenMapTiles © OpenStreetMap contributors"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    { "id": "land", "type": "background", "paint": { "background-color": "#E3D4B6" } },
    {
      "id": "wood", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["in", "class", "wood", "grass"],
      "paint": { "fill-color": "#CFC79F", "fill-opacity": 0.45 }
    },
    {
      "id": "ice", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["==", "class", "ice"],
      "paint": { "fill-color": "#F1ECE2", "fill-opacity": 0.8 }
    },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water", "paint": { "fill-color": "#F7F1E2" } },
    {
      "id": "water-shore", "type": "line", "source": "openmaptiles", "source-layer": "water",
      "paint": { "line-color": "#B9A480", "line-width": 0.8, "line-opacity": 0.7 }
    },
    {
      "id": "river", "type": "line", "source": "openmaptiles", "source-layer": "waterway", "minzoom": 6,
      "paint": { "line-color": "#F7F1E2", "line-width": 1.2 }
    },
    {
      "id": "road", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 7,
      "filter": ["in", "class", "motorway", "trunk", "primary"],
      "paint": { "line-color": "#C9B58F", "line-width": 1 }
    },
    {
      "id": "border", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
      "filter": ["==", "admin_level", 2],
      "paint": { "line-color": "#9C8361", "line-width": 1, "line-dasharray": [4, 3] }
    },
    {
      "id": "country-name", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "maxzoom": 7,
      "filter": ["==", "class", "country"],
      "layout": {
        "text-field": "{name:latin}", "text-font": ["Noto Sans Italic"], "text-size": 12,
        "text-transform": "uppercase", "text-letter-spacing": 0.18, "text-max-width": 7
      },
      "paint": { "text-color": "#6B5437", "text-halo-color": "#E3D4B6", "text-halo-width": 1.4 }
    },
    {
      "id": "city-name", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 4,
      "filter": ["in", "class", "city", "town"],
      "layout": { "text-field": "{name:latin}", "text-font": ["Noto Sans Italic"], "text-size": 12, "text-max-width": 8 },
      "paint": { "text-color": "#5C4930", "text-halo-color": "#E3D4B6", "text-halo-width": 1.4 }
    }
  ]
}
